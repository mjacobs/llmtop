# llmtop agent — systemd user unit.
#
# Install after `make install` has placed llmtop in ~/.local/bin:
#   cp llmtop-agent.service ~/.config/systemd/user/
#   # If XDG_BIN_HOME was customized, update ExecStart below to that path.
#   systemctl --user daemon-reload
#   systemctl --user enable --now llmtop-agent
#
# To survive logout/reboot without an active session, enable lingering once:
#   loginctl enable-linger $USER
#
# Listen, token, and endpoint settings belong in ~/.config/llmtop/config.toml on this
# host, not here.

[Unit]
Description=llmtop GPU/LLM telemetry agent
After=network-online.target

[Service]
ExecStart=%h/.local/bin/llmtop agent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
